# Server-only provider configuration. Never use the VITE_ prefix for secrets.
# Provider priority. The manual basic-sheet option is shown only after an AI error;
# it is not a provider and must not be listed here.
AI_PROVIDER_ORDER=nvidia,gemini,groq,openrouter

# Gemini; the project model is used if GEMINI_MODEL is omitted
GEMINI_API_KEY=
GEMINI_MODEL=
# Legacy compatibility: only the first entry is used; no model list is auto-tried.
GEMINI_MODELS=

# Providers are enabled only when both key and model are configured
GROQ_API_KEY=
GROQ_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Upstash Redis REST rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
AI_GLOBAL_DAILY_LIMIT=15

# Request resilience
AI_REQUEST_DEADLINE_MS=25000
AI_PROVIDER_TIMEOUT_MS=8000
AI_MAX_RETRIES=2
AI_BACKOFF_BASE_MS=1000
AI_BACKOFF_MAX_MS=4000
AI_BACKOFF_JITTER_MS=300
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=60000
